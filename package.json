{
  "name": "jev-shield",
  "version": "0.1.0",
  "private": true,
  "description": "Checks actions proposed by AI coding agents before they reach privileged tools, and scores untrusted text for prompt injection with TypeSafe Jev.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jev-shield": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && find dist/test -name '*.test.js' -exec node --test {} +",
    "start": "node dist/src/cli.js serve",
    "jev-shield": "node dist/src/cli.js"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
