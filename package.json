{
  "name": "jev-shield",
  "version": "0.1.0",
  "description": "Multimodal prompt-injection scanning and enforcement for LLM clients, MCP, Claude Code, and OpenAI-compatible applications.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesANZ/JevPromptShield.git"
  },
  "keywords": [
    "prompt-injection",
    "llm-security",
    "mcp",
    "claude-code",
    "multimodal"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jev-shield": "./dist/src/cli.js"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "corpus",
    "docs",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && find dist/test -name '*.test.js' -exec node --test {} +",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build",
    "start": "node dist/src/cli.js serve",
    "jev-shield": "node dist/src/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
