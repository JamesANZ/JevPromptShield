# Server-side TypeSafe key. Shield never marks a request safe when this call fails.
TYPESAFE_API_KEY=

# Placeholder thresholds until a dev-split sweep replaces them.
JEV_SHIELD_SUSPICIOUS_THRESHOLD=0.40
JEV_SHIELD_MALICIOUS_THRESHOLD=0.75

JEV_SHIELD_HOST=127.0.0.1
JEV_SHIELD_PORT=8787

# Optional cheap LLM judge and canary harness. GPT-4o mini is preferred when both keys exist.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BASELINE_PROVIDER=
BASELINE_MODEL=

# Action gate. Used by `jev-shield hook claude`. Local allows do not need the API key.
# ask: when Jev cannot be reached, require confirmation. block: deny those commands.
JEV_SHIELD_FAIL_MODE=ask
# dev, staging, or production. Sent to Jev as a label. Omit to leave it unset.
JEV_SHIELD_ENV_CLASS=dev
# Append-only audit log. Defaults to ~/.jev-shield/audit.jsonl.
JEV_SHIELD_AUDIT_LOG=
# Per-attempt timeout for an action review, in milliseconds. 100 to 10000. Default 2500.
JEV_SHIELD_JEV_TIMEOUT_MS=2500

