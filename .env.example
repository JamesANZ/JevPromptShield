# Server-side TypeSafe key. Shield never marks a request safe when this call fails.
TYPESAFE_API_KEY=

# Calibrated on the 53-case development split on 2026-10-27.
# The separate test split remains reserved for final evaluation.
JEV_SHIELD_SUSPICIOUS_THRESHOLD=0.70
JEV_SHIELD_MALICIOUS_THRESHOLD=0.75
# Document comparison. A document matches when its probability is at least this value.
JEV_SHIELD_COMPARE_THRESHOLD=0.50

JEV_SHIELD_HOST=127.0.0.1
JEV_SHIELD_PORT=8787

# Image OCR and audio transcription, and the optional cheap LLM judge.
# Required to score an image or an audio file. The transcript is what Jev scores.
OPENAI_API_KEY=
# Vision model for text written in an image. Default gpt-4o-mini.
JEV_SHIELD_VISION_MODEL=
# Speech-to-text model. Default whisper-1.
JEV_SHIELD_TRANSCRIBE_MODEL=
# Transcription timeout in milliseconds, from 1000 to 120000. Default 30000.
JEV_SHIELD_TRANSCRIBE_TIMEOUT_MS=
# Guarded OpenAI-compatible proxy. Loopback only, port 8788 by default.
JEV_SHIELD_PROXY_HOST=127.0.0.1
JEV_SHIELD_PROXY_PORT=8788
JEV_SHIELD_PROXY_SCAN_TIMEOUT_MS=20000
# Optional trusted application-policy summary sent as Jev context, never raw system prompts.
JEV_SHIELD_PROXY_CONTEXT=
# Defaults to https://api.openai.com/v1 when unset.
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
BASELINE_PROVIDER=
BASELINE_MODEL=

# Action gate. Used by `jev-shield hook claude`. Local allows do not need the API key.
# ask: when Jev cannot be reached, require confirmation. block: deny those commands.
JEV_SHIELD_FAIL_MODE=ask
# dev, staging, or production. Sent to Jev as a label. Omit to leave it unset.
JEV_SHIELD_ENV_CLASS=dev
# Append-only audit log. Defaults to ~/.jev-shield/audit.jsonl.
JEV_SHIELD_AUDIT_LOG=
# Per-attempt timeout for an action review, in milliseconds. 100 to 10000. Default 2500.
JEV_SHIELD_JEV_TIMEOUT_MS=2500

